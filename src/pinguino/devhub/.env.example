# Point the DevHub at the AMO API. Copy to `.env` (gitignored) and fill in.

# A logged-in AMO session id. Sent as `Authorization: Session <id>`. The API
# endpoints are scoped to this user, so no separate author is needed.
VITE_AMO_SESSION_ID=

# API base URL. Defaults to same-origin /api/v5 (local olympia via nginx).
# VITE_AMO_API_BASE=/api/v5
