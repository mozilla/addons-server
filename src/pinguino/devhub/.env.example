# Point the DevHub at the AMO API. Copy to `.env` (gitignored) and fill in.
# With these unset, the app uses built-in mock data.

# A logged-in AMO session id. Sent as `Authorization: Session <id>`.
VITE_AMO_SESSION_ID=

# The author whose add-ons to list (account id or username).
VITE_AMO_AUTHOR=

# API base URL. Defaults to same-origin /api/v5 (local olympia via nginx).
# VITE_AMO_API_BASE=/api/v5
